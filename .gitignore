__pycache__/

# 前端依赖：frontend/node_modules 是指向
# D:\VKBox_Lite\VKBoxLite_poll\frontend\node_modules 的 junction，
# 不随仓库分发（442MB）。详见 frontend/README.md「零、怎么运行」
frontend/node_modules/
node_modules/

# electron-builder 打包产物
frontend/dist/
dist/

# DSH 工具自身的工作目录，与仓库无关
.dsh-vision-toolkit/

# 现场截图/沟通用的图片目录，不进仓库
图/

# 临时调试脚本 (check_lua / 探针生成 / diff 分析等)
# commit 后清掉，加规则避免再次出现
.tmp_*.py
.tmp_*.txt
.tmp_*.sh

# LuatOS PC 模拟器日志（配置保留，日志忽略）
.simulator/logs/

# LuatOS PC 模拟器引擎本体（luatos-pc-64bit.exe 等，约 50MB）
# 手动安装一次即可，见 tools/run_lua_tests.bat 头部注释（官方 CDN 下载）
.simulator/LuatOS_PC/

# Agent 会话笔记（本地辅助，不进仓库）
.agent-memory/

# 烧录产物（去注释版固件，由 prep_burn 生成）
build/

# 根目录 package-lock.json（依赖在 frontend/ 下）
package-lock.json
